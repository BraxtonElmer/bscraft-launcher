[Unit]
Description=BSCraft skin service (launcher skin uploads, CustomSkinAPI files)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bscraft-skins
ExecStart=/usr/bin/python3 /home/ubuntu/bscraft-skins/skin_service.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# Sandbox: read-only everywhere except the two folders it owns
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/bscraft/skins /home/ubuntu/bscraft-skins/data

[Install]
WantedBy=multi-user.target
