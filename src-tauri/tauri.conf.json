{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BSCraft Launcher",
  "version": "1.1.2",
  "identifier": "com.zukashix.bsclauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BSCraft Launcher",
        "width": 960,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://bscraft.zukashix.com/launcher/version.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMTZFNkIxMjY3QTEwMDQKUldRRUVIb21zZVlXY2FuKytBR2hadnRqVm1VNWd4S21yV3c5ckt1WXRwelAvNXZ1QnhEblcrVHAK"
    }
  }
}
